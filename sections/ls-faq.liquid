{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;

    --faq-eyebrow-font-family: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    --faq-eyebrow-font-size: {{ section.settings.eyebrow_font_size }}px;
    --faq-eyebrow-color: {{ section.settings.eyebrow_color }};
    --faq-accent-color: {{ section.settings.accent_color }};
  }
{%- endstyle -%}

<div class="ls-faq section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width">
    <div class="ls-faq__wrapper">
      <div class="ls-faq__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ls-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          {% liquid
            assign heading_html = section.settings.heading
            if section.settings.heading_accent != blank and section.settings.heading contains section.settings.heading_accent
              assign accent_span = '<span class="ls-faq__heading-highlight">' | append: section.settings.heading_accent | append: '</span>'
              assign heading_html = section.settings.heading | replace: section.settings.heading_accent, accent_span
            endif
          %}
          <h2 class="ls-faq__heading h3">{{ heading_html }}</h2>
        {% endif %}

        {% if section.settings.contact_text != blank %}
          <div class="ls-faq__contact">{{ section.settings.contact_text }}</div>
        {% endif %}
      </div>

      <div class="ls-faq__items">
        {% for block in section.blocks %}
          {% capture accordion_content %}
            <details class="ls-faq__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
              <summary>
                {{ block.settings.question }}
                <svg class="ls-faq__icon" viewBox="0 0 6.5625 11.7188" fill="none" aria-hidden="true">
                  <path d="M0.71875 0L0 0.71875L5.14062 5.85938L0 11L0.71875 11.7188L6.21875 6.21875L6.5625 5.85938L6.21875 5.5L0.71875 0Z" fill="currentColor"/>
                </svg>
              </summary>
              <div class="ls-faq__answer details-content">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endcapture %}

          {% render 'accordion-custom-component',
            children: accordion_content,
            open: forloop.first
          %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "ls-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Questions"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "default": "caveat_n4"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow font size",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4a6b57"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The things parents actually ask."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent text",
      "info": "If this text appears in the heading above, it's highlighted in the accent color.",
      "default": "actually ask."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Used for the heading accent text and the question icons.",
      "default": "#4a6b57"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Contact prompt",
      "default": "<p>Still stuck? Go to our contact us page and talk to us!</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are barefoot shoes good for toddlers learning to walk?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. New walkers rely on feeling the ground to learn balance, which is why pediatric guidance favours bare feet for first steps. Barefoot shoes keep that ground feel while protecting feet outdoors.</p>"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are barefoot shoes good for toddlers learning to walk?",
            "answer": "<p>Yes. New walkers rely on feeling the ground to learn balance, which is why pediatric guidance favours bare feet for first steps. Barefoot shoes keep that ground feel while protecting feet outdoors.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do barefoot shoes cause flat feet?",
            "answer": "<p>No — it's usually the opposite. A wide toe box and zero-drop sole let the arch develop and strengthen naturally, instead of being propped up by rigid support.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What age is it okay to put an AirTag in my kid's shoe?",
            "answer": "<p>There's no strict minimum age. Most parents add one once their child starts walking to school or daycare alone, but you can use the AirTag pocket as soon as it gives you peace of mind.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How much room should kids' shoes have?",
            "answer": "<p>Leave about a thumb's width (roughly half an inch) between the longest toe and the front of the shoe. That gives room to grow without being so loose it affects balance.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How often should I measure my kid's feet?",
            "answer": "<p>Kids' feet can grow up to two sizes a year. Measure every 2-3 months for toddlers and every 4-6 months for older kids to stay ahead of growth spurts.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What makes a shoe truly “barefoot”?",
            "answer": "<p>A wide toe box, zero drop, a flexible sole that bends with the foot, and no added arch support — letting feet move and develop the way they would unshod.</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
