{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="ls-faq section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width">
    <div class="ls-faq__wrapper">
      <div class="ls-faq__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="ls-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ls-faq__heading h3">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ls-faq__description">{{ section.settings.description }}</div>
        {% endif %}
      </div>

      <div class="ls-faq__items">
        {% for block in section.blocks %}
          {% capture accordion_content %}
            <details class="ls-faq__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
              <summary>
                {{ block.settings.question }}
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 4l6 6-6 6"/>
                </svg>
              </summary>
              <div class="ls-faq__answer details-content">
                {{ block.settings.answer }}
              </div>
            </details>
          {% endcapture %}

          {% render 'accordion-custom-component',
            children: accordion_content,
            open: forloop.first
          %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "ls-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Find answers to common questions about our barefoot shoes.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What makes barefoot shoes different?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Barefoot shoes feature a wide toe box, zero drop, flexible sole, and no arch support — allowing feet to move naturally.</p>"
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
