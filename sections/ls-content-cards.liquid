{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="ls-content-cards section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width">
    <div class="ls-content-cards__grid">
      {% for block in section.blocks %}
        <div class="ls-content-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="ls-content-card__image">
              {{ block.settings.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 750px) 33vw, 100vw'
              }}
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h4 class="ls-content-card__title">{{ block.settings.title }}</h4>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ls-content-card__description">{{ block.settings.description }}</div>
          {% endif %}

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="ls-content-card__link">
              {{ block.settings.link_text | default: 'Read more' }}
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 10h12M12 4l6 6-6 6"/>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Content cards",
  "tag": "section",
  "class": "ls-content-cards-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>A brief description of this content.</p>"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Content cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
