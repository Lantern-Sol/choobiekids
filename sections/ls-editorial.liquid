{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
    {% if section.settings.accent_color != blank %}
      --editorial-accent: {{ section.settings.accent_color }};
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ls-editorial__image {
    --editorial-image-radius: {{ section.settings.image_border_radius }}px;
  }
  #shopify-section-{{ section.id }} .ls-editorial__grid {
    --editorial-column-gap: {{ section.settings.content_image_gap }}px;
  }
  #shopify-section-{{ section.id }} .ls-editorial__heading-break {
    display: {% if section.settings.wrap_heading_accent_mobile %}inline{% else %}none{% endif %};
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .ls-editorial__heading-break {
      display: {% if section.settings.wrap_heading_accent %}inline{% else %}none{% endif %};
    }
  }
{%- endstyle -%}

<div class="ls-editorial section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width" style="position: relative;">
    {% if section.settings.show_floating_icon %}
      {%- liquid
        assign icon_tag = 'div'
        if section.settings.enable_icon_parallax
          assign icon_tag = 'ls-floating-icon-parallax'
        endif
      -%}
      {% comment %}
        The icon lives in its own clip container so its horizontal overflow is
        clipped at the page-width edges (unchanged behaviour). Keeping this
        separate from .page-width lets the editorial image bleed past the
        page-width edge without being clipped.
      {% endcomment %}
      <div class="ls-editorial__icon-clip">
        <{{ icon_tag }} class="ls-floating-choobie ls-editorial__floating-icon"
          style="--icon-width: {{ section.settings.icon_width }}px; --icon-width-mobile: {{ section.settings.icon_width_mobile }}px; --icon-x: {{ section.settings.icon_x }}%; --icon-y: {{ section.settings.icon_y }}%; --icon-x-mobile: {{ section.settings.icon_x_mobile }}%; --icon-y-mobile: {{ section.settings.icon_y_mobile }}%; --icon-rotation: {{ section.settings.icon_rotation }}deg; --icon-rotation-mobile: {{ section.settings.icon_rotation_mobile }}deg;">
          <img
            src="{{ 'choobies-icon-2.svg' | asset_url }}"
            alt=""
            width="145"
            height="123"
            loading="lazy"
            class="ls-floating-choobie__img"
          >
        </{{ icon_tag }}>
      </div>
    {% endif %}

    <div class="ls-editorial__grid {% if section.settings.image_position == 'left' %}ls-editorial__grid--image-left{% endif %} {% if section.settings.image_full_bleed %}ls-editorial__grid--bleed{% endif %}">
      <div class="ls-editorial__content">
        {% if section.settings.subtitle != blank %}
          <p class="ls-editorial__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}

        {% if section.settings.heading_line_1 != blank %}
          <h2 class="ls-editorial__heading">
            {{ section.settings.heading_line_1 }}
            {% if section.settings.heading_line_2 != blank %}
              <br class="ls-editorial__heading-break"><span class="ls-editorial__heading-accent">{{ section.settings.heading_line_2 }}</span>
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="ls-editorial__body rte">
            {{ section.settings.body }}
          </div>
        {% endif %}

        {% if section.settings.body_mobile != blank %}
          <div class="ls-editorial__body-mobile rte">
            {{ section.settings.body_mobile }}
          </div>
        {% endif %}

        {% if section.settings.spec_text != blank or section.settings.spec_text_2 != blank or section.settings.spec_text_3 != blank or section.settings.spec_text_4 != blank %}
          <div class="ls-editorial__specs">
            {% if section.settings.spec_text != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text }}</div>
            {% endif %}
            {% if section.settings.spec_text_2 != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text_2 }}</div>
            {% endif %}
            {% if section.settings.spec_text_3 != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text_3 }}</div>
            {% endif %}
            {% if section.settings.spec_text_4 != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text_4 }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="ls-editorial__media">
        {% if section.settings.image != blank %}
          <div class="ls-editorial__image">
            {{ section.settings.image | image_url: width: 1472 | image_tag:
              loading: 'lazy',
              widths: '375, 550, 736, 1100, 1472',
              sizes: '(min-width: 750px) 57vw, 100vw'
            }}
          </div>
        {% else %}
          <div class="ls-editorial__image ls-editorial__image--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.show_floating_icon %}
  {% comment %} Loaded unconditionally so toggling parallax on via the theme editor's AJAX section swap still works {% endcomment %}
  <script src="{{ 'ls-floating-icon-parallax.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "LS Editorial",
  "tag": "section",
  "class": "ls-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Displayed in handwritten font above the heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (accent color)",
      "info": "Displayed in the accent color set below"
    },
    {
      "type": "checkbox",
      "id": "wrap_heading_accent",
      "label": "Wrap accent to its own line (desktop)",
      "default": true,
      "info": "When off, heading line 2 stays inline with heading line 1 instead of breaking onto a new line"
    },
    {
      "type": "checkbox",
      "id": "wrap_heading_accent_mobile",
      "label": "Wrap accent to its own line (mobile)",
      "default": true,
      "info": "Controls the line break on mobile independently of desktop"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Colors the subtitle and heading line 2. Defaults to green.",
      "default": "#4A6B57"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_mobile",
      "label": "Body text (mobile only)"
    },
    {
      "type": "richtext",
      "id": "spec_text",
      "label": "Spec / citation 1",
      "info": "Displayed with a coral left border"
    },
    {
      "type": "richtext",
      "id": "spec_text_2",
      "label": "Spec / citation 2",
      "info": "Optional second citation with coral left border"
    },
    {
      "type": "richtext",
      "id": "spec_text_3",
      "label": "Spec / citation 3",
      "info": "Optional third citation with coral left border"
    },
    {
      "type": "richtext",
      "id": "spec_text_4",
      "label": "Spec / citation 4",
      "info": "Optional fourth citation with coral left border"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "image_full_bleed",
      "label": "Extend image to screen edge",
      "default": false,
      "info": "Removes the outer margin so the image bleeds to the edge of the screen (both edges on mobile). Only affects this section's image."
    },
    {
      "type": "range",
      "id": "content_image_gap",
      "label": "Gap between text and image (desktop)",
      "min": 24,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_floating_icon",
      "label": "Show Choobies icon",
      "default": false,
      "info": "Decorative floating mascot icon"
    },
    {
      "type": "range",
      "id": "icon_rotation",
      "label": "Icon rotation (desktop)",
      "min": -180,
      "max": 180,
      "step": 5,
      "default": 0,
      "unit": "deg",
      "info": "The icon is symmetric, so rotation alone covers any orientation — no separate flip control needed"
    },
    {
      "type": "range",
      "id": "icon_rotation_mobile",
      "label": "Icon rotation (mobile)",
      "min": -180,
      "max": 180,
      "step": 5,
      "default": 0,
      "unit": "deg"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon size (desktop)",
      "min": 100,
      "max": 260,
      "step": 10,
      "default": 190,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_width_mobile",
      "label": "Icon size (mobile)",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_x",
      "label": "Icon horizontal position (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "info": "Center of the icon, as a % of the section width"
    },
    {
      "type": "range",
      "id": "icon_y",
      "label": "Icon vertical position (desktop)",
      "min": -30,
      "max": 130,
      "step": 2,
      "default": 0,
      "unit": "%",
      "info": "Center of the icon, as a % of the section height. Below 0% or above 100% pokes above/below the section"
    },
    {
      "type": "range",
      "id": "icon_x_mobile",
      "label": "Icon horizontal position (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "icon_y_mobile",
      "label": "Icon vertical position (mobile)",
      "min": -30,
      "max": 130,
      "step": 2,
      "default": 0,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "enable_icon_parallax",
      "label": "Enable parallax effect on icon",
      "default": false,
      "info": "The icon drifts gently as visitors scroll past this section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "LS Editorial"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
