{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="ls-editorial section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width" style="position: relative;">
    {% if section.settings.show_floating_icon %}
      <div class="ls-floating-choobie ls-editorial__floating-icon{% if section.settings.image_position == 'left' %} ls-editorial__floating-icon--image-left{% endif %}{% if section.settings.icon_bottom %} ls-editorial__floating-icon--bottom{% endif %}"
        {% if section.settings.icon_flip or section.settings.icon_rotation != 0 %}style="transform:{% if section.settings.icon_flip %} scaleX(-1){% endif %}{% if section.settings.icon_rotation != 0 %} rotate({{ section.settings.icon_rotation }}deg){% endif %}"{% endif %}>
        <img
          src="{{ 'choobies-icon-2.svg' | asset_url }}"
          alt=""
          width="145"
          height="123"
          loading="lazy"
          class="ls-floating-choobie__img"
        >
      </div>
    {% endif %}

    <div class="ls-editorial__grid {% if section.settings.image_position == 'left' %}ls-editorial__grid--image-left{% endif %}">
      <div class="ls-editorial__content">
        {% if section.settings.subtitle != blank %}
          <p class="ls-editorial__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}

        {% if section.settings.heading_line_1 != blank %}
          <h2 class="ls-editorial__heading">
            {{ section.settings.heading_line_1 }}
            {% if section.settings.heading_line_2 != blank %}
              <br><span class="ls-editorial__heading-accent">{{ section.settings.heading_line_2 }}</span>
            {% endif %}
          </h2>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="ls-editorial__body rte">
            {{ section.settings.body }}
          </div>
        {% endif %}

        {% if section.settings.spec_text != blank or section.settings.spec_text_2 != blank %}
          <div class="ls-editorial__specs">
            {% if section.settings.spec_text != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text }}</div>
            {% endif %}
            {% if section.settings.spec_text_2 != blank %}
              <div class="ls-editorial__spec rte">{{ section.settings.spec_text_2 }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="ls-editorial__media">
        {% if section.settings.image != blank %}
          <div class="ls-editorial__image">
            {{ section.settings.image | image_url: width: 1472 | image_tag:
              loading: 'lazy',
              widths: '375, 550, 736, 1100, 1472',
              sizes: '(min-width: 750px) 57vw, 100vw'
            }}
          </div>
        {% else %}
          <div class="ls-editorial__image ls-editorial__image--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LS Editorial",
  "tag": "section",
  "class": "ls-editorial-section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Displayed in handwritten font above the heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (accent color)",
      "info": "Displayed in green accent color"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "richtext",
      "id": "spec_text",
      "label": "Spec / citation 1",
      "info": "Displayed with a coral left border"
    },
    {
      "type": "richtext",
      "id": "spec_text_2",
      "label": "Spec / citation 2",
      "info": "Optional second citation with coral left border"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "show_floating_icon",
      "label": "Show Choobies icon",
      "default": false,
      "info": "Decorative floating mascot icon"
    },
    {
      "type": "checkbox",
      "id": "icon_flip",
      "label": "Flip icon horizontally",
      "default": false,
      "info": "Mirror the icon left-to-right"
    },
    {
      "type": "checkbox",
      "id": "icon_bottom",
      "label": "Icon at bottom",
      "default": false,
      "info": "Place icon near the bottom of the section instead of the top"
    },
    {
      "type": "range",
      "id": "icon_rotation",
      "label": "Icon rotation",
      "min": -180,
      "max": 180,
      "step": 5,
      "default": 0,
      "unit": "deg",
      "info": "Rotate the floating Choobies icon"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "LS Editorial"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
