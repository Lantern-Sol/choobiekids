{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="ls-features section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width">
    <div class="ls-features__grid">
      {% for block in section.blocks %}
        <div class="ls-feature" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div
              class="ls-feature__icon"
              style="
                --icon-bg: {{ block.settings.icon_background_color }};
                --icon-size: {{ block.settings.icon_size | divided_by: 16.0 }}rem;
                --icon-padding: {{ block.settings.icon_padding | divided_by: 16.0 }}rem;
                --icon-radius: {{ block.settings.icon_border_radius | divided_by: 16.0 }}rem;
              "
            >
              {{ block.settings.icon | image_url: width: 112 | image_tag:
                loading: 'lazy',
                widths: '56, 112',
                sizes: '56px'
              }}
            </div>
          {% endif %}

          {% if block.settings.title != blank or block.settings.description != blank %}
            <div class="ls-feature__content">
              {% if block.settings.title != blank %}
                <h4 class="ls-feature__title">{{ block.settings.title }}</h4>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="ls-feature__description">{{ block.settings.description }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Features",
  "tag": "section",
  "class": "ls-features-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf7f0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "header",
          "content": "Icon background"
        },
        {
          "type": "color",
          "id": "icon_background_color",
          "label": "Background color",
          "default": "#4a6b57"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Background size",
          "min": 32,
          "max": 96,
          "step": 4,
          "default": 56,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "icon_padding",
          "label": "Icon padding",
          "min": 0,
          "max": 32,
          "step": 2,
          "default": 16,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "icon_border_radius",
          "label": "Corner radius",
          "min": 0,
          "max": 48,
          "step": 2,
          "default": 12,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>A short description of this feature.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
