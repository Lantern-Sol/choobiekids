{{ 'ls-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color != blank %}
      --color-background: {{ section.settings.background_color }};
      background-color: {{ section.settings.background_color }};
    {% endif %}
    --padding-block-start: {{ section.settings.padding_top }}px;
    --padding-block-end: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .ls-newsletter__submit {
    background-color: {{ section.settings.button_background | default: settings.color_palette.color1 }};
    color: {{ section.settings.button_text_color | default: settings.color_palette.background }};
  }
{%- endstyle -%}

<div class="ls-newsletter section" style="padding-block-start: var(--padding-block-start); padding-block-end: var(--padding-block-end);">
  <div class="page-width">
    <div class="ls-newsletter__wrapper">
      <div class="ls-newsletter__content">
        {% if section.settings.heading != blank %}
          <h2 class="ls-newsletter__heading h3">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="ls-newsletter__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      <div class="ls-newsletter__form-wrapper">
        {% form 'customer', id: 'ls-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.posted_successfully? %}
            <p class="ls-newsletter__message" role="status">
              {{ section.settings.success_message | default: 'Thanks for subscribing!' }}
            </p>
          {% endif %}

          {% if form.errors %}
            <p class="ls-newsletter__message" role="alert">
              {{ form.errors.translated_fields['email'] | capitalize }}
              {{ form.errors.messages['email'] }}
            </p>
          {% endif %}

          <div class="ls-newsletter__form">
            <input
              class="ls-newsletter__input"
              type="email"
              name="contact[email]"
              id="ls-newsletter-email"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
              required
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="ls-newsletter-error"
              {% endif %}
            >
            <button type="submit" class="ls-newsletter__submit">
              {{ section.settings.button_text | default: 'Subscribe' }}
            </button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "ls-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign up for updates on new releases and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
