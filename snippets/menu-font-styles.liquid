{%- doc -%}
  Derives CSS variables from the menu typography settings for 1st level/main menu items.

  The drawer (mobile) uses its own typography settings when present, falling back to the
  primary (desktop) settings so existing menus keep their current look.

  @param {object} settings - The block settings object containing typography settings.
  @param {string} menu_type - The menu type: 'drawer' or 'mega_menu'.
{%- enddoc -%}

{%- liquid
  if menu_type == 'drawer'
    assign font_link = settings.type_font_drawer_link | default: settings.type_font_primary_link
    assign font_weight = settings.type_font_drawer_weight | default: settings.type_font_primary_weight | default: 700
    assign font_case = settings.type_case_drawer_link | default: settings.type_case_primary_link
    assign font_size = settings.type_font_drawer_size | default: '1rem'
  else
    assign font_link = settings.type_font_primary_link
    assign font_weight = settings.type_font_primary_weight | default: 700
    assign font_case = settings.type_case_primary_link
  endif
-%}
--menu-top-level-font-family: var(--font-{{ font_link }}--family);
--menu-top-level-font-size-desktop: {{ settings.type_font_primary_size }}; --menu-top-level-font-style: var(--font-
{{- font_link -}}
--style); --menu-top-level-font-weight: {{ font_weight }}; --menu-top-level-font-case:
{%- if font_case == 'uppercase' %}uppercase{% else %}none{% endif -%}
;
{% if menu_type == 'drawer' %}
  --menu-top-level-font-size: {{ font_size }}; --menu-top-level-font-line-height:
  var(--menu-font-2xl--line-height);
{% else %}
  --menu-top-level-font-size: var(--menu-font-sm--size); --menu-top-level-font-line-height:
  var(--menu-font-sm--line-height);
{% endif %}
--menu-top-level-font-color: var(--color-foreground); --menu-top-level-font-color-rgb: var(--color-foreground-rgb);
