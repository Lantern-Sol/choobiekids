{%- doc -%}
  Variant picker styles consolidated into a single snippet for reliable CSS subsetting.
  Rendered from both the variant-main-picker snippet (product pages, where the picker
  originally renders) and from the product-card-related blocks and sections that can
  spawn a quick-add modal (collection/search pages), so the dropdown variant picker
  styles are available when the quick-add modal injects a variant picker via fetched
  product page HTML.

  @example
  {% render 'variant-picker-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-variant-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
    color: var(--color-variant-text);
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .variant-option__select-wrapper:hover .variant-option__select {
    background-color: var(--color-variant-hover-background);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    background-color: var(--color-variant-background);
    color: inherit;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  /* ─── Choobie: size buttons + US/EU toggle (Figma) ──────────────────────────
     Scoped to button-style options so colour-swatch pickers (product cards) are
     untouched. Applies on the PDP and in the quick-add modal (same markup). */
  .variant-option--buttons {
    /* Figma tokens: consumed by the button rules in base.css. */
    --color-variant-border: #c7d1cb;
    --color-variant-background: #ffffff;
    --color-variant-text: #2c353f;
    --color-variant-text-rgb: 44 53 63;
    --color-variant-hover-border: #c7d1cb;
    --color-variant-hover-background: #ffffff;
    --color-variant-hover-text: #2c353f;
    --color-selected-variant-border: #3b4754;
    --color-selected-variant-background: #edf0ee;
    --color-selected-variant-text: #2c353f;
    --color-selected-variant-hover-border: #3b4754;
    --color-selected-variant-hover-background: #edf0ee;
    --color-selected-variant-hover-text: #2c353f;
    --options-border-radius: 0.25rem; /* 4px */
    --options-border-width: 1px;
  }

  .variant-picker .variant-option--buttons {
    gap: 0.5rem; /* 8px */
  }

  /* Cap the grid column width (else it sizes to the full "5C / 21" string), and
     use auto-fill so a product with few sizes stays compact/left-aligned instead
     of auto-fit stretching them. Narrower on mobile so all sizes fit one row. */
  .variant-picker .variant-option--equal-width-buttons {
    --variant-min-width: 3rem; /* 48px (mobile) */
    grid-template-columns: repeat(auto-fill, minmax(var(--variant-min-width), 1fr));
  }

  .variant-picker .variant-option--buttons .variant-option__button-label {
    min-width: var(--variant-min-width);
    min-height: 2.875rem; /* 46px */
    padding: 0.5625rem 0.25rem; /* 9px / 4px so long EU values fit narrow buttons */
  }

  @media screen and (min-width: 750px) {
    .variant-picker .variant-option--equal-width-buttons {
      --variant-min-width: 4.5rem; /* 72px (desktop) */
    }
  }

  .variant-picker .variant-option--buttons .variant-option__button-label__text {
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 0.875rem; /* 14px */
    line-height: 1.2;
    text-align: center;
  }

  /* Sold-out AND pre-order values: grey fill + grey text (both are crossed). */
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-available='false']),
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-preorder='true']) {
    background-color: #e2e3e5;
    color: #87898b;
  }

  /* Keep the grey fill/text on hover for crossed values (no Figma hover shift). */
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-available='false']):hover,
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-preorder='true']):hover {
    --color-variant-hover-background: #e2e3e5;
    --color-variant-hover-text: #87898b;
  }

  /* Selected and out-of-stock use a 1.5px border (Figma; default is 1px). */
  .variant-picker .variant-option--buttons .variant-option__button-label:has(:checked),
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-available='false']),
  .variant-picker .variant-option--buttons .variant-option__button-label:has([data-option-preorder='true']) {
    --options-border-width: 1.5px;
  }

  /* Selected value: Figma shadow-2. */
  .variant-picker .variant-option--buttons .variant-option__button-label:has(:checked) {
    box-shadow: 0 1px 2px -1px rgb(0 0 0 / 0.1), 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }

  /* Strike spans the full button (not inset by the border) so it reaches the corners. */
  .variant-picker .variant-option--buttons .variant-option__strikethrough {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
  }

  /* "Size" label row: name on the left, US/EU toggle pushed to the right edge.
     The legend must span the full width for space-between to have room. */
  .variant-option__legend--with-system {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .variant-size-system {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .variant-size-system__opt {
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    font-family: var(--font-body--family);
    font-size: 0.875rem; /* 14px */
    font-weight: 400;
    line-height: 1.2;
    color: #2c353f;
    cursor: pointer;
  }

  /* Active side is bold + underlined. Driven off the picker-root attribute so it
     survives morphs and matches the saved (localStorage) preference — no JS
     class bookkeeping. */
  .variant-picker:not([data-size-system='eu']) .variant-size-system__opt--us,
  .variant-picker[data-size-system='eu'] .variant-size-system__opt--eu {
    font-weight: 700;
    border-bottom-color: #3b4754;
  }

  /* Show one half of each "US / EU" value based on the chosen system (default US). */
  .variant-size-part--eu {
    display: none;
  }

  .variant-picker[data-size-system='eu'] .variant-size-part--us {
    display: none;
  }

  .variant-picker[data-size-system='eu'] .variant-size-part--eu {
    display: inline;
  }
{% endstylesheet %}
