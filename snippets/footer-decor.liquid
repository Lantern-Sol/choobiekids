{%- endif -%}

<style>
  footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .footer-decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .footer-decor__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .footer-decor__svg--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .footer-decor__svg--desktop {
      display: none;
    }

    .footer-decor__svg--mobile {
      display: block;
    }
  }
</style>
