{%- doc -%}
  Renders a color switcher for a custom "combined listing": a group of sibling
  products (one per color) linked through the `custom.product_group` metaobject.
  Each sibling links to its own product page; the current product is shown selected.

  Matches the Figma "Color variants" component (node 9178:7446): a caption-bold
  label showing the current color name, then a row of 48x62 rounded image swatches.

  Color is expressed by product identity (one product per color), NOT by a variant
  option — so Size stays the only native variant inside each product and nothing is
  duplicated in the variant picker. The color name comes from the `custom.color_label`
  metafield (falling back to the product title); the chip is the product's featured image.

  @param {object} product - The current product object.
  @param {object} [block] - The block object, for theme editor attributes.

  @example
  {% render 'sibling-color-switcher', product: product, block: block %}
{%- enddoc -%}

{% liquid
  assign siblings = product.metafields.custom.product_group.value.products.value
  assign current_label = product.metafields.custom.color_label | default: product.title
%}

{%- if siblings and siblings.count > 1 -%}
  <div class="sibling-color-switcher" {{ block.shopify_attributes }}>
    <span class="sibling-color-switcher__legend">{{ current_label }}</span>
    <ul class="sibling-color-switcher__list" role="list">
      {%- for sibling in siblings -%}
        {%- liquid
          assign color_label = sibling.metafields.custom.color_label | default: sibling.title
          assign chip_image = sibling.featured_image
        -%}
        <li class="sibling-color-switcher__item">
          {%- if sibling.id == product.id -%}
            <span
              class="sibling-color-switcher__swatch is-selected"
              aria-current="true"
              title="{{ color_label | escape }}"
            >
              {%- if chip_image -%}
                {{ chip_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', class: 'sibling-color-switcher__img', alt: color_label }}
              {%- else -%}
                <span class="visually-hidden">{{ color_label }}</span>
              {%- endif -%}
            </span>
          {%- else -%}
            <a
              class="sibling-color-switcher__swatch"
              href="{{ sibling.url }}"
              title="{{ color_label | escape }}"
            >
              {%- if chip_image -%}
                {{ chip_image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', class: 'sibling-color-switcher__img', alt: color_label }}
              {%- else -%}
                <span class="visually-hidden">{{ color_label }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .sibling-color-switcher {
    display: flex;
    flex-direction: column;
  }

  .sibling-color-switcher__legend {
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 0.875rem; /* Brand Font Size/Caption = 14px */
    line-height: 1.2;
    color: var(--color-foreground); /* Text/default = #2c353f */
  }

  .sibling-color-switcher__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem; /* 8px */
    margin: 0;
    padding: 0.5rem 0 0; /* 8px above the swatch row */
    list-style: none;
  }

  .sibling-color-switcher__swatch {
    display: block;
    width: 3rem; /* 48px */
    height: 3.875rem; /* 62px */
    padding: 0;
    overflow: hidden;
    background: none;
    border: 1px solid #c7d1cb; /* Borders/default = secondary/200 */
    border-radius: 0.25rem; /* 4px */
    cursor: pointer;
    transition: border-color 0.1s ease;
  }

  .sibling-color-switcher__swatch:hover {
    border-color: #3b4754; /* Borders/brand = primary/500 */
  }

  .sibling-color-switcher__swatch.is-selected {
    border-color: #3b4754; /* Borders/brand = primary/500 */
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px 0 rgb(0 0 0 / 0.1);
  }

  .sibling-color-switcher__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
