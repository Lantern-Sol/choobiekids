{%- doc -%}
  Product badge styles consolidated into a single snippet.

  @example
  {% render 'product-badges-styles' %}
{%- enddoc -%}

{% stylesheet %}
  .product-badges {
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);

    /* Stack multiple badges (e.g. Pre-order + discount) at the anchored corner */
    display: flex;
    flex-direction: column;
    gap: var(--padding-2xs, 0.4rem);
    align-items: flex-start;
  }

  .product-badges--top-right {
    align-items: flex-end;
  }

  /* Inline variant (e.g. product page): flows in normal layout instead of
     absolutely positioned over media. */
  .product-badges--inline {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: var(--badge-inline-justify, flex-start);
  }

  /* Inline badge host (product page block). Collapses only when the product has
     no badge on ANY variant (truly empty). When some variants have a badge, the
     block renders an invisible placeholder for no-badge variants (below) so the
     host keeps its height and nothing shifts on variant change. */
  product-badge {
    display: block;
  }

  product-badge:empty {
    display: none;
  }

  /* Invisible height-reserving placeholder: occupies the exact badge height. */
  .product-badges--placeholder {
    visibility: hidden;
  }

  .product-badges--placeholder .product-badges__badge {
    animation: none;
  }

  /* Smooth the badge in when it (re)renders on variant change. Freshly inserted
     nodes replay this each swap; the JS skips the swap when unchanged. */
  @keyframes badge-inline-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .product-badges--inline .product-badges__badge {
    animation: badge-inline-in 130ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-badges--inline .product-badges__badge {
      animation: none;
    }
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    right: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size, var(--font-size--xs));
    font-family: var(--badge-font-family, var(--font-body--family));
    font-weight: var(--badge-font-weight, var(--font-body--weight));
    text-transform: var(--badge-text-transform, none);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }
{% endstylesheet %}
