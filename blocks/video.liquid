{% assign block_settings = block.settings %}

{%- liquid
  # Resolve the desktop aspect-ratio. A user override (anything other than
  # 'auto') wins over the source-derived default.
  if block_settings.aspect_ratio != blank and block_settings.aspect_ratio != 'auto'
    assign resolved_aspect_ratio = block_settings.aspect_ratio
  elsif block_settings.source == 'uploaded'
    assign resolved_aspect_ratio = block_settings.video.aspect_ratio | default: 'auto'
  else
    assign resolved_aspect_ratio = 'auto'
  endif
-%}

{% capture video_style %}
  {%  render 'spacing-style', settings: block_settings %}
  {% render 'border-override', settings: block_settings %}
   --size-style-width: {{ block_settings.custom_width }}%; --size-style-width-mobile: {{ block_settings.custom_width_mobile }}%; --size-style-height: 100%;
   --size-style-aspect-ratio: {{ resolved_aspect_ratio }};
   {% if block_settings.aspect_ratio_mobile != blank %}--size-style-aspect-ratio-mobile: {{ block_settings.aspect_ratio_mobile }};{% endif %}
{% endcapture %}

{%- liquid
  # Map the 9-point button anchor to flex align/justify tracks. The overlay is
  # a flex box covering the media; vertical = align-items, horizontal = justify-content.
  case block_settings.button_position
    when 'top-left'
      assign button_align = 'flex-start'
      assign button_justify = 'flex-start'
    when 'top-center'
      assign button_align = 'flex-start'
      assign button_justify = 'center'
    when 'top-right'
      assign button_align = 'flex-start'
      assign button_justify = 'flex-end'
    when 'middle-left'
      assign button_align = 'center'
      assign button_justify = 'flex-start'
    when 'middle-center'
      assign button_align = 'center'
      assign button_justify = 'center'
    when 'middle-right'
      assign button_align = 'center'
      assign button_justify = 'flex-end'
    when 'bottom-left'
      assign button_align = 'flex-end'
      assign button_justify = 'flex-start'
    when 'bottom-right'
      assign button_align = 'flex-end'
      assign button_justify = 'flex-end'
    else
      assign button_align = 'flex-end'
      assign button_justify = 'center'
  endcase
-%}

<div
  class="video-block"
  style="--video-button-align: {{ button_align }}; --video-button-justify: {{ button_justify }};"
  {{ block.shopify_attributes }}
>
  {% if block_settings.source == 'uploaded' %}
    {% render 'video',
      video: block_settings.video,
      video_class: 'spacing-style size-style border-style',
      video_loop: block_settings.video_loop,
      video_style: video_style,
      video_preview_image: block_settings.video.preview_image
    %}
  {% else %}
    {% render 'video',
      video_from_url: true,
      video: block_settings.video_url.id,
      video_class: 'spacing-style size-style border-style',
      video_type: block_settings.video_url.type,
      video_style: video_style,
      video_alt: block_settings.alt,
      video_preview_image: block_settings.cover_image
    %}
  {% endif %}

  {%- if block_settings.button_label != blank -%}
    <div class="video-block__overlay">
      <a
        class="{{ block_settings.button_style }} video-block__button"
        {% if block_settings.button_link == blank %}
          role="link"
          aria-disabled="true"
        {% else %}
          href="{{ block_settings.button_link }}"
        {% endif %}
        {%- if block_settings.button_open_in_new_tab -%}
          target="_blank"
          rel="noopener noreferrer"
        {%- endif -%}
      >
        {{ block_settings.button_label }}
      </a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .placeholder-video {
    aspect-ratio: 5 / 3;
  }

  /*
    Apply the aspect ratio to the <deferred-media> container itself, not
    only the inner img/video. base.css's .size-style sets height: 100%,
    which would otherwise win over aspect-ratio — height: auto lets the
    ratio drive the container height.
  */
  deferred-media[style*='--size-style-aspect-ratio'] {
    aspect-ratio: var(--size-style-aspect-ratio, auto);
    height: auto;
  }

  /* Cover-fit any video/image content inside the block so a forced
     aspect ratio fills the box without letterboxing. */
  deferred-media video,
  deferred-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile aspect-ratio override. Inline style on <deferred-media> sets
     --size-style-aspect-ratio, so we need !important to rebind it for
     mobile — every existing rule reading the var then picks up the
     mobile value automatically. */
  @media screen and (max-width: 749px) {
    deferred-media[style*='--size-style-aspect-ratio-mobile'] {
      --size-style-aspect-ratio: var(--size-style-aspect-ratio-mobile) !important;
    }
  }

  /* Positioning context for the button overlay; full-width in the flex column. */
  .video-block {
    position: relative;
    width: 100%;
  }

  /* Blockify the media (custom element defaults to inline, ignoring aspect-ratio). */
  .video-block > deferred-media,
  .video-block > .video-placeholder-wrapper {
    display: block;
  }

  /* Full-media flex layer that anchors the button. pointer-events:none lets
     clicks fall through to the play/pause poster button underneath; the button
     itself re-enables them so it stays clickable. */
  .video-block__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: var(--video-button-align, flex-end);
    justify-content: var(--video-button-justify, center);
    padding: 1.5rem;
    pointer-events: none;
  }

  .video-block__button {
    pointer-events: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "t:settings.video_source",
      "options": [
        {
          "value": "uploaded",
          "label": "t:options.video_uploaded"
        },
        {
          "value": "url",
          "label": "t:options.video_external_url"
        }
      ],
      "default": "uploaded"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.source == 'uploaded' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_external_url",
      "info": "t:info.video_external",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:settings.video_autoplay",
      "info": "t:info.video_autoplay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.video_loop",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:settings.cover_image",
      "visible_if": "{{ block.settings.source == 'url' and block.settings.video_autoplay == false }}"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "t:settings.video_alt_text",
      "info": "t:info.video_alt_text",
      "visible_if": "{{ block.settings.source == 'url' }}"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_open_in_new_tab",
      "label": "Open link in new tab",
      "default": false,
      "visible_if": "{{ block.settings.button_label != blank }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "button-unstyled", "label": "Link" }
      ],
      "default": "button",
      "visible_if": "{{ block.settings.button_label != blank }}"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Button position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-center",
      "visible_if": "{{ block.settings.button_label != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "info": "Overrides the source's native aspect ratio.",
      "options": [
        { "value": "auto", "label": "t:options.auto" },
        { "value": "9/16", "label": "Portrait 9:16" },
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "1/1", "label": "Square" },
        { "value": "6.9/5", "label": "Landscape 6.9:5" },
        { "value": "16/9", "label": "Landscape 16:9" },
        { "value": "18/7", "label": "Short banner 18:7" },
        { "value": "4/1", "label": "Short banner 4:1" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Mobile aspect ratio",
      "info": "Overrides the aspect ratio on screens under 750px.",
      "options": [
        { "value": "", "label": "Same as desktop" },
        { "value": "auto", "label": "Auto" },
        { "value": "3.6/3", "label": "Portrait 3.6:3" },
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "9/16", "label": "Portrait 9:16" },
        { "value": "1/1", "label": "Square" },
        { "value": "6.9/5", "label": "Landscape 6.9:5" },
        { "value": "16/9", "label": "Landscape 16:9" },
        { "value": "39/56", "label": "Portrait 39:56" },
        { "value": "13/12", "label": "Short banner 13:12" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.video",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
