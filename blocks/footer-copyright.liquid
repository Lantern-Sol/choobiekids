{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
    {%- if block_settings.show_credit and block_settings.credit_link_text != blank %}
      | {{ block_settings.credit_prefix }}
      {%- if block_settings.credit_url != blank %}
        <a
          class="footer-utilities__credit-link"
          href="{{ block_settings.credit_url }}"
          target="_blank"
          rel="noopener noreferrer"
        >{{ block_settings.credit_link_text }}</a>
      {%- else %}
        {{ block_settings.credit_link_text }}
      {%- endif %}
    {%- endif -%}
  </span>
</div>

{% stylesheet %}
  .footer-utilities__group-copyright {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .footer-utilities__credit-link {
    text-decoration: underline;
    text-underline-position: from-font;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_credit",
      "label": "Show credit",
      "default": true
    },
    {
      "type": "text",
      "id": "credit_prefix",
      "label": "Credit text",
      "default": "Designed by",
      "visible_if": "{{ block.settings.show_credit }}"
    },
    {
      "type": "text",
      "id": "credit_link_text",
      "label": "Credit link label",
      "default": "LanternSol",
      "visible_if": "{{ block.settings.show_credit }}"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit link",
      "visible_if": "{{ block.settings.show_credit }}"
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
