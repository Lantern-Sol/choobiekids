  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Content comes from a Size chart metaobject entry (see setup notes): a product’s own “Size chart” metafield wins; otherwise the entry marked “Use as store default”. If the entry has no table rows and no video, the whole size guide is hidden."
    },
    {
      "type": "text",
      "id": "prompt_text",
      "label": "Prompt text",
      "default": "Not sure of the size?"
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Toggle label",
      "default": "Size guide"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Chart content"
    },
    {
      "type": "paragraph",
      "content": "Content is managed in Content → Metaobjects → Size chart."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "stripe_color",
      "label": "Row stripe color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "toggle_color",
      "label": "Link color",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
