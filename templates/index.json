      }
    },
    "the_pocket": {
      "type": "ls-editorial",
      "settings": {
        "subtitle": "The Pocket",
        "heading_line_1": "A shoe",
        "heading_line_2": "locator.",
        "body": "<p>Choobies feature a built-in, AirTag-compatible compartment designed to help parents quickly find a missing shoe when life gets chaotic. The compartment keeps the AirTag enclosed, secure, and comfortably away from the foot.</p>",
        "spec_text": "<p>”An AirTag is designed to help locate belongings. Apple and AirTag are trademarks of Apple, Inc. Choobies is not endorsed, sponsored by or affiliated with Apple Inc.\"</p>",
        "spec_text_2": "",
        "image_position": "left",
        "image_border_radius": 0,
        "image_full_bleed": true,
        "show_floating_icon": true,
        "icon_rotation": 40,
        "icon_rotation_mobile": 0,
