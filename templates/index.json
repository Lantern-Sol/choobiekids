    "faq": {
      "type": "ls-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "What are barefoot shoes?",
            "answer": "<p>Barefoot shoes mimic the feeling of walking barefoot while protecting your child's feet. They feature a wide toe box, zero drop heel, thin flexible sole, and no arch support.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "What age are Choobie shoes for?",
            "answer": "<p>Our shoes are designed for active kids. Check our size guide for specific age and foot measurements.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "How do I find the right size?",
            "answer": "<p>We recommend measuring your child's feet and using our detailed size guide. When in doubt, size up for growing room.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Are barefoot shoes safe for kids?",
            "answer": "<p>Research shows that barefoot shoes support natural foot development in children. They allow feet to move, flex, and strengthen as nature intended.</p>"
          }
        }
      },
