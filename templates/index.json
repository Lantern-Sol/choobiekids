    "the_research": {
      "type": "ls-editorial",
      "settings": {
        "subtitle": "The Research",
        "heading_line_1": "Why This Matters for Parents.",
        "heading_line_2": "",
        "body": "<p>Children's feet are not miniature adult feet. They're soft, malleable, and rapidly developing.<br/><strong>Barefoot shoes:</strong></p><ul><li>Protect without restricting</li><li>Encourage natural sensory feedback</li><li>Support lifelong healthy movement patterns</li></ul><p>Two studies worth reading:</p>",
        "spec_text": "<p><strong>Habitually Barefoot vs. Shod Children</strong><br/>Nature · Scientific Reports - <a href=\"https://www.nature.com/articles/s41598-017-07868-4\" target=\"_blank\">Hollander et al., 2017↗</a></p>",
        "spec_text_2": "<p><strong>Barefoot or Shod? Footwear & Children's Gait</strong><br/>Applied Sciences (MDPI) - <a href=\"https://www.mdpi.com/2076-3417/16/1/286\" target=\"_blank\">Systematic Review, 2026↗</a></p>",
        "image_position": "right",
        "image_border_radius": 12,
        "image_full_bleed": false,
        "show_floating_icon": true,
        "icon_rotation": 0,
        "icon_rotation_mobile": 35,
        "icon_width": 230,
        "icon_width_mobile": 160,
        "icon_x": 16,
        "icon_y": 110,
        "icon_x_mobile": 80,
        "icon_y_mobile": 62,
        "enable_icon_parallax": true,
        "background_color": "",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
