    "why_barefoot": {
      "type": "ls-editorial",
      "settings": {
        "subtitle": "Why Barefoot",
        "heading_line_1": "Kids learn balance, posture and coordination",
        "heading_line_2": "through natural movement. ",
        "body": "<p>A toddler's foot is mostly soft cartilage. The bones won't finish hardening for years. Barefoot shoes help protect and strengthen growing feet without restricting natural movement.</p>",
        "spec_text": "<p>Wide toe box · zero drop · 5.5 mm flexible sole · no arch support.</p>",
        "spec_text_2": "",
        "image_position": "right",
        "image_border_radius": 0,
        "image_full_bleed": true,
        "show_floating_icon": true,
        "icon_rotation": 0,
        "icon_rotation_mobile": 40,
        "icon_width": 180,
        "icon_width_mobile": 120,
        "icon_x": 43,
